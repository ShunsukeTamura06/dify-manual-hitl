# GROWI Adapter 設定
# このファイルをコピーして .env を作り、実際の値を設定する:
#   cp .env.example .env
# .env は gitignore 済み（コミットされない）

# ── GROWI 接続 ──
# GROWI のベース URL（末尾スラッシュなし）
GROWI_BASE_URL=https://growi.example.com

# GROWI API トークン
# 取得方法: GROWI にログイン → 個人設定 → API 設定 → API Token 発行
# ★ ここに後で貼り付ける ★
GROWI_API_TOKEN=

# ── このサービス自身の設定 ──
# 待ち受けポート
PORT=8001

# ログレベル (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# ログ出力ディレクトリ
LOG_DIR=logs

# 生レスポンスを返す /debug 系を有効にするか（診断用。本番常用なら false 可）
DEBUG_ENDPOINTS_ENABLED=true

# マニュアルのルートパス（このプレフィックス配下のみ対象にする）
# 空にすると GROWI 全ページが対象
MANUAL_ROOT_PATH=/manuals

# GROWI API リクエストのタイムアウト秒
REQUEST_TIMEOUT=30
