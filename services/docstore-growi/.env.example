# GROWI Adapter 設定
# このファイルをコピーして .env を作り、実際の値を設定する:
#   cp .env.example .env
# .env は gitignore 済み（コミットされない）

# ── GROWI 接続 ──
# GROWI のベース URL（末尾スラッシュなし）
GROWI_BASE_URL=https://growi.example.com

# GROWI API トークン
# 取得方法: GROWI にログイン → 個人設定 → API 設定 → API Token 発行
# ★ ここに後で貼り付ける ★
GROWI_API_TOKEN=

# ── このサービス自身の設定 ──
# API キー認証（推奨）。設定すると全エンドポイント（/health 除く）で
# X-API-Key ヘッダを要求する。空なら認証なし（ローカル開発用）。
# 呼び出し側（sync の DOCSTORE_API_KEY / Dify アプリの DOCSTORE_API_KEY 環境変数）にも同じ値を設定する。
ADAPTER_API_KEY=

# 待ち受けポート
PORT=8001

# ログレベル (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# ログ出力ディレクトリ
LOG_DIR=logs

# 生レスポンスを返す /debug 系を有効にするか（既定 false。診断時のみ true にする）
DEBUG_ENDPOINTS_ENABLED=false

# マニュアルのルートパス（このプレフィックス配下のみ対象にする）
# 空にすると GROWI 全ページが対象
MANUAL_ROOT_PATH=/manuals

# GROWI API リクエストのタイムアウト秒
REQUEST_TIMEOUT=30
