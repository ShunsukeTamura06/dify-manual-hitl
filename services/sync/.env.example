# Sync Service 設定
# このファイルをコピーして .env を作る:
#   cp .env.example .env
# .env は gitignore 済み

# ── DocStore Adapter 接続 ──
# 同期元。GROWI Adapter 等の DocStore 実装の URL
# （Sync Service は Wiki 実装を知らない。Adapter の URL だけ知る）
DOCSTORE_URL=http://localhost:8001

# Adapter 側で ADAPTER_API_KEY を設定した場合、同じ値をここに（X-API-Key として送る）
DOCSTORE_API_KEY=

# ── Dify Knowledge API 接続 ──
# 同期先。Dify の API ベース URL（末尾スラッシュなし、/v1 は付けない）
DIFY_API_BASE_URL=http://localhost:5001

# Dify のナレッジ API キー（ナレッジ設定 → API → APIキー）
# ★ ここに後で貼り付ける ★
DIFY_API_KEY=

# 同期先の Dataset ID（Phase 1a で作ったナレッジの ID）
# ★ ここに後で貼り付ける ★
DIFY_DATASET_ID=

# ── 同期挙動 ──
# Dify のインデックス方式（high_quality / economy）
DIFY_INDEXING_TECHNIQUE=high_quality

# 1ページあたりのソースヘッダを本文に埋め込むか（引用用）
EMBED_SOURCE_HEADER=true

# ── このサービス自身 ──
# API キー認証（推奨）。設定すると全エンドポイント（/health 除く）で
# X-API-Key ヘッダを要求する。空なら認証なし（ローカル開発用）。
SYNC_API_KEY=

PORT=8002
LOG_LEVEL=INFO
LOG_DIR=logs

# 生レスポンスを返す /debug 系を有効にするか（既定 false。診断時のみ true にする）
DEBUG_ENDPOINTS_ENABLED=false

REQUEST_TIMEOUT=60
